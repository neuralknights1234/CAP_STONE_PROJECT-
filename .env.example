# SmartAgri OS - Backend Environment Variables Configuration Template
# Copy this file to .env or export these variables in your deployment environment

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartagri_os
DB_USERNAME=root
DB_PASSWORD=root
JPA_DDL_AUTO=update
SHOW_SQL=false

# Security & JWT Configuration
# Secure key must be at least 256 bits (32+ characters)
JWT_SECRET=smartagri-super-secret-jwt-key-minimum-256-bits-for-security-compliance-in-smartagrios
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
